{
  "name": "delta",
  "productName": "Delta",
  "version": "0.2.0",
  "description": "Local-first branching conversations with AI",
  "main": ".vite/build/main.cjs",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "electron-forge start",
    "prepackage": "node scripts/clean-build.mjs",
    "package": "electron-forge package",
    "premake": "node scripts/clean-build.mjs",
    "make": "electron-forge make",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test",
    "test:app": "playwright test",
    "test:package": "node scripts/smoke.mjs",
    "icon:generate": "swift scripts/generate-app-icon.swift",
    "icon:build": "bash scripts/build-icon.sh",
    "test:icon": "node scripts/verify-icon.mjs",
    "release": "bash scripts/release.sh",
    "knex:migrate:make": "knex --knexfile knexfile.ts migrate:make --"
  },
  "author": {
    "name": "Dan Corin",
    "email": "dan@wvlen.llc"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/danielcorin/Delta.git"
  },
  "dependencies": {
    "better-sqlite3": "^13.1.1",
    "knex": "^3.1.0",
    "sqlite-vec": "^0.1.6"
  },
  "overrides": {
    "@electron/asar": { "glob": "^14.0.5", "minimatch": "^11.0.8" },
    "@typescript-eslint/typescript-estree": { "minimatch": "^11.0.8" }
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.102",
    "@ai-sdk/google": "^4.0.118",
    "@ai-sdk/openai": "^4.0.115",
    "@ai-sdk/openai-compatible": "^3.0.90",
    "ai": "^7.0.170",
    "zod": "^4.1.8",
    "@electron-forge/cli": "^8.0.1",
        "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/dagre": "^0.7.52",
    "@types/node": "^24",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.3.0",
    "@xyflow/react": "^12.3.5",
    "autoprefixer": "^10.4.20",
    "dagre": "^0.8.5",
    "electron": "45.3.0",
    "eslint": "^9.39.0",
    "@eslint/js": "^9.39.0",
    "typescript-eslint": "^8.46.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^4.0.0",
    "@playwright/test": "^1.56.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hotkeys-hook": "^4.6.1",
    "react-markdown": "^9.0.1",
    "react-syntax-highlighter": "^16.1.2",
    "remark-gfm": "^4.0.0",
    "ulid": "^3.0.1"
  }
}
