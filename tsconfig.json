{
  "compilerOptions": {
    "jsx": "react-jsx", "target": "ES2023", "module": "ESNext",
    "skipLibCheck": true, "esModuleInterop": true, "strict": true,
    "sourceMap": true, "baseUrl": ".", "moduleResolution": "bundler",
    "resolveJsonModule": true, "noEmit": true, "types": ["node", "vite/client"]
  },
  "include": ["src", "*.ts", "tests"]
}
